# 开发环境配置
VITE_APP_NAME=Music Practice Assistant (Dev)
VITE_APP_VERSION=1.0.0-dev

# API配置 - 本地模拟服务器
VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_TIMEOUT=30000

# 功能开关 - 开发环境全部开启
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_AI_ANALYSIS=true
VITE_ENABLE_OFFLINE_MODE=true

# 认证配置
VITE_AUTH_TOKEN_KEY=music_app_dev_token
VITE_AUTH_REFRESH_KEY=music_app_dev_refresh
VITE_ALLOW_MOCK_AUTH=true

# 音频配置
VITE_AUDIO_SAMPLE_RATE=44100
VITE_AUDIO_BUFFER_SIZE=2048

# 性能配置 - 开发环境开启监控
VITE_PERFORMANCE_MONITOR_ENABLED=true
VITE_FPS_WARNING_THRESHOLD=30

# 订阅配置 - 开发环境测试值
VITE_SUBSCRIPTION_FREE_LIMIT=999
VITE_SUBSCRIPTION_PREMIUM_PRICE_MONTHLY=0
VITE_SUBSCRIPTION_PREMIUM_PRICE_YEARLY=0

# 开发工具
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=debug