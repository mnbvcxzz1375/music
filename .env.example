# ==========================================
# 应用配置 (Frontend)
# ==========================================
VITE_APP_NAME=Music Practice Assistant
VITE_APP_VERSION=2.0.0
VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_TIMEOUT=30000

# ==========================================
# 后端环境 (Backend Server)
# ==========================================
NODE_ENV=development
PORT=3001

# Database (PostgreSQL) - 对应 docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_USER=music_master
DB_PASSWORD=secret123
DB_NAME=musicdb

# Redis - 对应 docker-compose.yml
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# 音频/性能/功能配置 (保留原有)
VITE_AUDIO_SAMPLE_RATE=44100
VITE_AUDIO_BUFFER_SIZE=2048
VITE_PERFORMANCE_MONITOR_ENABLED=true
VITE_FPS_WARNING_THRESHOLD=30
VITE_SUBSCRIPTION_FREE_LIMIT=10