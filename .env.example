# 应用配置
VITE_APP_NAME=Music Practice Assistant
VITE_APP_VERSION=1.0.0

# API配置
VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_TIMEOUT=30000

# 功能开关
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_AI_ANALYSIS=true
VITE_ENABLE_OFFLINE_MODE=true

# 认证配置
VITE_AUTH_TOKEN_KEY=music_app_token
VITE_AUTH_REFRESH_KEY=music_app_refresh

# 音频配置
VITE_AUDIO_SAMPLE_RATE=44100
VITE_AUDIO_BUFFER_SIZE=2048

# 性能配置
VITE_PERFORMANCE_MONITOR_ENABLED=true
VITE_FPS_WARNING_THRESHOLD=30

# 订阅配置
VITE_SUBSCRIPTION_FREE_LIMIT=10
VITE_SUBSCRIPTION_PREMIUM_PRICE_MONTHLY=29.99
VITE_SUBSCRIPTION_PREMIUM_PRICE_YEARLY=299.99

# 外部服务 (开发环境使用模拟数据)
VITE_STRIPE_PUBLIC_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_WECHAT_APP_ID=